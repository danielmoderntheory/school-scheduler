# Neon Database Configuration
# Get your connection string from the Neon dashboard
NEON_DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Database environment indicator - shown in local dev UI
# Set to "production" when pointing to prod db, "staging" for dev/preview
NEXT_PUBLIC_DB_ENV=staging

# App Password (optional - leave empty to disable auth)
APP_VIEW_PASSWORD=
APP_ADMIN_PASSWORD=

# OR-Tools Solver API (server-side, used by Vercel proxy)
# For local development (run: cd backend && ./run-local.sh):
SCHEDULER_API_URL=http://localhost:8080
# To test against Cloud Run production:
# SCHEDULER_API_URL=https://school-scheduler-api-xxxxx.us-central1.run.app

# Direct Cloud Run URL (client-side, bypasses Vercel's 10s timeout)
# Set this to call Cloud Run directly from the browser for longer solver runs
# Leave empty to use Vercel proxy only (subject to 10s timeout on free tier)
NEXT_PUBLIC_SOLVER_URL=http://localhost:8080
# For production:
# NEXT_PUBLIC_SOLVER_URL=https://school-scheduler-api-xxxxx.us-central1.run.app

# Debug mode for solver (enables verbose logging in backend)
# Set to "1" or "true" to enable, run backend with: DEBUG_SOLVER=1 ./run-local.sh
# DEBUG_SOLVER=1
